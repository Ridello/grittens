# Copy to .env (never commit .env). Placeholders only.
PAYMENT_MODE=mock            # mock | busha
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=            # Bearer secret key (NGN bank-transfer route)
BUSHA_PUBLIC_KEY=            # X-BU-PUBLIC-KEY (USDT payment-request route). Leave empty => USDT shown unavailable
BUSHA_WEBHOOK_SECRET=        # secret shown once when creating the webhook in Busha dashboard
BUSHA_USDT_NETWORK=TRX
ADMIN_EMAIL=amaka@example.com
ADMIN_PASSWORD=              # required: merchant dashboard password
SESSION_SECRET=              # long random string for signing the merchant cookie
PORT=3000
DB_PATH=data.db
